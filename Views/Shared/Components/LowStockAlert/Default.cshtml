@model IEnumerable<QuanLyNhaHang.Models.BranchStock>

@if (Model != null && Model.Any())
{
    <div class="alert alert-danger shadow-sm mb-4" role="alert">
        <h6 class="alert-heading fw-bold mb-2">⚠️ Cảnh báo Hết Nguyên Liệu!</h6>
        <ul class="mb-2">
            @foreach (var item in Model)
            {
                <li><strong>@item.Ingredient.Name:</strong> Chỉ còn @item.Quantity @item.Ingredient.Unit (Tối thiểu: @item.Ingredient.MinLevel)</li>
            }
        </ul>
        <a href="/Inventory" class="btn btn-sm btn-outline-danger">Đi tới kho</a>
    </div>
}