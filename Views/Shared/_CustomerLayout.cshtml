@{
    var hasCustomerSession = Context.Request.Cookies.ContainsKey("RestaurantCustomerSession");
    var cartCount = 0;
    try {
        var cartJson = Context.Session.GetString("customer-cart-v1");
        if (!string.IsNullOrWhiteSpace(cartJson)) {
            using var cartDoc = System.Text.Json.JsonDocument.Parse(cartJson);
            foreach (var entry in cartDoc.RootElement.EnumerateArray()) {
                if (entry.TryGetProperty("Qty", out var qty) && qty.TryGetInt32(out var n)) cartCount += Math.Max(0, n);
            }
        }
    } catch { cartCount = 0; }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#183f35" />
    <title>@(ViewData["Title"] ?? "Đặt món online") · Vị Nhà</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="customer-site">
    <nav class="customer-nav">
        <a class="customer-nav-brand" href="/khach-hang"><span class="customer-nav-mark">V</span><span>VỊ NHÀ<small>NGON NHƯ CƠM NHÀ</small></span></a>
        <div class="customer-nav-links">
            <a class="customer-nav-menu" href="/khach-hang">Thực đơn</a>
            <a href="/khach-hang/gio-hang" class="customer-nav-cart"><span aria-hidden="true">♧</span> Giỏ hàng <span class="customer-cart-count">@cartCount</span></a>
            @if (hasCustomerSession)
            {
                <a href="/khach-hang/lich-su">Đơn hàng</a>
                <a href="/khach-hang/tai-khoan">Tài khoản</a>
                <form method="post" action="/khach-hang/dang-xuat" class="m-0">@Html.AntiForgeryToken()<button type="submit" class="customer-nav-login">Đăng xuất</button></form>
            }
            else
            {
                <a href="/khach-hang/dang-nhap" class="customer-nav-login">Đăng nhập</a>
                <a href="/khach-hang/dang-ky" class="customer-nav-register">Tạo tài khoản <span aria-hidden="true">→</span></a>
            }
        </div>
    </nav>
    @if (TempData["CustomerWelcome"] != null)
    {
        <div class="container pt-3"><div class="alert alert-success alert-dismissible fade show mb-0" role="status">@TempData["CustomerWelcome"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button></div></div>
    }
    <main>@RenderBody()</main>
    <footer class="customer-footer"><span>© @DateTime.Now.Year Vị Nhà</span><span>Bữa cơm ngon, niềm vui trọn vẹn.</span><a href="/khach-hang">Khám phá thực đơn</a></footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
