@model QuanLyNhaHang.Controllers.CustomerController.RegisterInput
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Tạo tài khoản"; }
<section class="auth-page">
    <div class="auth-shell auth-shell-register">
        <aside class="auth-story">
            <a class="auth-brand" href="/khach-hang"><span class="auth-brand-mark">V</span><span>VỊ NHÀ<small>NGON NHƯ CƠM NHÀ</small></span></a>
            <div class="auth-story-copy">
                <span class="auth-eyebrow">CHÀO MỪNG BẠN ĐẾN VỚI VỊ NHÀ</span>
                <h1>Món ngon yêu thích,<br /><em>ngay tại nhà.</em></h1>
                <p>Tạo tài khoản để đặt món dễ dàng, lưu địa chỉ giao hàng và theo dõi đơn hàng của bạn.</p>
                <div class="auth-benefits">
                    <div><span class="auth-benefit-icon">✓</span><span><b>Đặt món nhanh chóng</b><small>Lưu thông tin để đặt hàng thuận tiện hơn.</small></span></div>
                    <div><span class="auth-benefit-icon">⌂</span><span><b>Giao tận nhà hoặc tự lấy</b><small>Chọn cách nhận món phù hợp với bạn.</small></span></div>
                    <div><span class="auth-benefit-icon">♡</span><span><b>Quản lý đơn hàng</b><small>Xem lại lịch sử và trạng thái đơn.</small></span></div>
                </div>
            </div>
            <div class="auth-story-footer">Vị Nhà · Bữa cơm ngon, niềm vui trọn vẹn.</div>
            <div class="auth-orb auth-orb-one"></div><div class="auth-orb auth-orb-two"></div>
        </aside>
        <div class="auth-form-panel">
            <div class="auth-mobile-brand"><span class="auth-brand-mark">V</span><b>VỊ NHÀ</b></div>
            <div class="auth-form-head"><span class="auth-eyebrow">BẮT ĐẦU CÙNG VỊ NHÀ</span><h2>Tạo tài khoản</h2><p>Điền thông tin bên dưới để đăng ký thành viên.</p></div>
            <form asp-controller="Customer" asp-action="Register" method="post" class="auth-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="auth-validation-summary" role="alert"></div>
                <div class="auth-field"><label asp-for="FullName">Họ và tên <span>*</span></label><input asp-for="FullName" class="auth-input" placeholder="Ví dụ: Nguyễn Minh Anh" autocomplete="name" maxlength="120" autofocus /><span asp-validation-for="FullName" class="auth-field-error"></span></div>
                <div class="auth-field"><label asp-for="Email">Địa chỉ email <span>*</span></label><input asp-for="Email" class="auth-input" type="email" placeholder="ban@example.com" autocomplete="email" maxlength="180" /><span asp-validation-for="Email" class="auth-field-error"></span></div>
                <div class="auth-field"><label asp-for="Password">Mật khẩu <span>*</span></label><div class="auth-password-wrap"><input asp-for="Password" class="auth-input" type="password" placeholder="Ít nhất 8 ký tự" autocomplete="new-password" minlength="8" maxlength="100" id="registerPassword" /><button type="button" class="auth-show-password" data-password-toggle="registerPassword" aria-label="Hiện mật khẩu">Hiện</button></div><span asp-validation-for="Password" class="auth-field-error"></span><small class="auth-hint">Không sử dụng mật khẩu dễ đoán hoặc mật khẩu bạn đang dùng ở nơi khác.</small></div>
                <div class="auth-field"><label asp-for="Phone">Số điện thoại <small>(không bắt buộc)</small></label><input asp-for="Phone" class="auth-input" type="tel" placeholder="09xx xxx xxx" autocomplete="tel" maxlength="30" /><span asp-validation-for="Phone" class="auth-field-error"></span></div>
                <div class="auth-field"><label asp-for="Address">Địa chỉ nhận hàng mặc định <small>(không bắt buộc)</small></label><input asp-for="Address" class="auth-input" placeholder="Số nhà, đường, phường/xã..." autocomplete="street-address" maxlength="500" /><span asp-validation-for="Address" class="auth-field-error"></span></div>
                <p class="auth-terms">Bằng việc tạo tài khoản, bạn đồng ý cung cấp thông tin chính xác để nhà hàng xử lý đơn hàng.</p>
                <button type="submit" class="auth-submit">Tạo tài khoản <span aria-hidden="true">→</span></button>
            </form>
            <div class="auth-switch">Đã có tài khoản? <a href="/khach-hang/dang-nhap">Đăng nhập</a></div>
            <a class="auth-back-link" href="/khach-hang">← Quay lại thực đơn</a>
        </div>
    </div>
</section>
<script>
 document.querySelectorAll('[data-password-toggle]').forEach(function (button) {
   button.addEventListener('click', function () {
     var input = document.getElementById(button.getAttribute('data-password-toggle'));
     if (!input) return;
     var show = input.type === 'password'; input.type = show ? 'text' : 'password';
     button.textContent = show ? 'Ẩn' : 'Hiện'; button.setAttribute('aria-label', show ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
   });
 });
</script>
