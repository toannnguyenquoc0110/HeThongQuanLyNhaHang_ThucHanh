@model IEnumerable<QuanLyNhaHang.Models.MenuItem>

@{
    ViewData["Title"] = "Thực đơn trực tuyến";
    Layout = "_CustomerLayout";

    var currentTab = ViewBag.Tab as string ?? "items";
    var categories = ViewBag.Categories as List<QuanLyNhaHang.Models.MenuCategory>
                     ?? new List<QuanLyNhaHang.Models.MenuCategory>();
    var combos = ViewBag.Combos as List<QuanLyNhaHang.Models.Combo>
                 ?? new List<QuanLyNhaHang.Models.Combo>();
    var promos = ViewBag.Promos as List<QuanLyNhaHang.Models.Promotion>
                 ?? new List<QuanLyNhaHang.Models.Promotion>();
    var coupons = ViewBag.Coupons as List<QuanLyNhaHang.Models.Coupon>
                  ?? new List<QuanLyNhaHang.Models.Coupon>();

    var menuItems = Model?.ToList() ?? new List<QuanLyNhaHang.Models.MenuItem>();
}

<style>
    .customer-menu {
        --menu-accent: #d97706;
        --menu-dark: #29251f;
        --menu-muted: #77736c;
        color: var(--menu-dark);
        padding-bottom: 48px;
    }

        .customer-menu .menu-hero {
            position: relative;
            overflow: hidden;
            padding: 34px;
            border-radius: 24px;
            background: linear-gradient(120deg, #29251f, #514333);
            color: white;
            margin-bottom: 28px;
        }

        .customer-menu .hero-kicker {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: #ffdf9a;
            font-size: .82rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .customer-menu .menu-hero h1 {
            font-size: clamp(1.7rem, 4vw, 2.6rem);
            font-weight: 800;
            letter-spacing: -.7px;
            margin: 12px 0;
        }

        .customer-menu .menu-hero p {
            max-width: 570px;
            color: #e8e0d5;
            line-height: 1.7;
            margin-bottom: 0;
        }

        .customer-menu .hero-decoration {
            position: absolute;
            right: 38px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 115px;
            opacity: .16;
            pointer-events: none;
        }

        .customer-menu .btn-menu-cart {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 9px;
            background: #fbbf24;
            color: #29251f;
            border: 0;
            border-radius: 14px;
            padding: 13px 19px;
            font-weight: 800;
            text-decoration: none;
            transition: .2s ease;
        }

            .customer-menu .btn-menu-cart:hover {
                background: #f59e0b;
                transform: translateY(-2px);
                color: #29251f;
            }

        .customer-menu #cart-badge {
            font-size: .72rem;
            min-width: 22px;
        }

        .customer-menu .menu-benefits {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 28px;
        }

        .customer-menu .benefit {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px;
            background: white;
            border: 1px solid #eee9e1;
            border-radius: 16px;
        }

        .customer-menu .benefit-icon {
            width: 43px;
            height: 43px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            border-radius: 13px;
            background: #fff4d9;
            color: #b77913;
            font-size: 1.25rem;
        }

        .customer-menu .benefit strong {
            display: block;
            font-size: .9rem;
        }

        .customer-menu .benefit small {
            color: var(--menu-muted);
        }

        .customer-menu .menu-tabs {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            padding: 8px;
            background: #f4f1eb;
            border-radius: 16px;
            margin-bottom: 25px;
        }

            .customer-menu .menu-tabs .nav-link {
                color: #5f594f;
                font-weight: 700;
                padding: 12px 17px;
                border-radius: 11px;
                transition: .2s;
            }

                .customer-menu .menu-tabs .nav-link:hover {
                    background: white;
                }

                .customer-menu .menu-tabs .nav-link.active {
                    color: #29251f;
                    background: white;
                    box-shadow: 0 3px 12px #30271912;
                }

        .customer-menu .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 12px;
            margin: 25px 0 18px;
        }

            .customer-menu .section-heading h2 {
                font-size: 1.45rem;
                font-weight: 800;
                margin-bottom: 5px;
            }

            .customer-menu .section-heading p {
                margin: 0;
                color: var(--menu-muted);
                font-size: .92rem;
            }

        .customer-menu .menu-filter {
            background: white;
            padding: 16px;
            border: 1px solid #eee9e1;
            border-radius: 17px;
            margin-bottom: 24px;
        }

        .customer-menu .form-control,
        .customer-menu .form-select {
            min-height: 45px;
            border-color: #e8e2d8;
            border-radius: 10px;
        }

            .customer-menu .form-control:focus,
            .customer-menu .form-select:focus {
                border-color: #e8b44f;
                box-shadow: 0 0 0 .2rem #fbbf241c;
            }

        .customer-menu .btn-filter {
            min-height: 45px;
            width: 100%;
            border: 0;
            border-radius: 10px;
            background: #29251f;
            color: white;
            font-weight: 700;
        }

            .customer-menu .btn-filter:hover {
                background: #514333;
            }

        .customer-menu .food-card {
            height: 100%;
            overflow: hidden;
            background: white;
            border: 1px solid #eee9e1;
            border-radius: 19px;
            transition: transform .22s ease, box-shadow .22s ease;
        }

            .customer-menu .food-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 35px #34291812;
            }

        .customer-menu .food-art {
            height: 145px;
            display: grid;
            place-items: center;
            position: relative;
            background: linear-gradient(145deg, #fff8e8, #f7e9cb);
            overflow: hidden;
        }

            .customer-menu .food-art::before,
            .customer-menu .food-art::after {
                content: "";
                position: absolute;
                width: 120px;
                height: 120px;
                border-radius: 50%;
                background: #ffffff70;
            }

            .customer-menu .food-art::before {
                top: -70px;
                left: -35px;
            }

            .customer-menu .food-art::after {
                right: -50px;
                bottom: -85px;
                width: 160px;
                height: 160px;
            }

        .customer-menu .food-emoji {
            position: relative;
            z-index: 1;
            display: grid;
            place-items: center;
            width: 94px;
            height: 94px;
            background: #ffffffc9;
            border: 1px solid #ffffff;
            border-radius: 50%;
            box-shadow: 0 8px 25px #8d6a2414;
            font-size: 3.4rem;
            transition: transform .25s ease;
        }

        .customer-menu .food-card:hover .food-emoji {
            transform: scale(1.07) rotate(-4deg);
        }

        .customer-menu .food-badge {
            position: absolute;
            z-index: 2;
            top: 12px;
            left: 12px;
            background: #29251f;
            color: white;
            border-radius: 7px;
            padding: 6px 9px;
            font-size: .7rem;
            font-weight: 700;
        }

            .customer-menu .food-badge.sold-out {
                background: #77736c;
            }

        .customer-menu .food-content {
            padding: 17px;
            display: flex;
            flex-direction: column;
            height: calc(100% - 145px);
        }

        .customer-menu .food-category {
            color: #a36b12;
            text-transform: uppercase;
            letter-spacing: .6px;
            font-size: .69rem;
            font-weight: 800;
            margin-bottom: 7px;
        }

        .customer-menu .food-name {
            font-size: 1.02rem;
            font-weight: 800;
            line-height: 1.45;
            margin-bottom: 8px;
            min-height: 45px;
        }

        .customer-menu .food-description {
            color: var(--menu-muted);
            font-size: .83rem;
            line-height: 1.55;
            margin-bottom: 12px;
        }

        .customer-menu .food-meta {
            color: var(--menu-muted);
            font-size: .78rem;
            margin-bottom: 13px;
        }

        .customer-menu .food-price {
            color: #b42318;
            font-size: 1.3rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .customer-menu .btn-add-food {
            width: 100%;
            border: 1px solid #29251f;
            background: #29251f;
            color: white;
            border-radius: 11px;
            padding: 11px 9px;
            font-weight: 700;
            transition: .2s;
        }

            .customer-menu .btn-add-food:hover:not(:disabled) {
                background: #fbbf24;
                border-color: #fbbf24;
                color: #29251f;
            }

            .customer-menu .btn-add-food:disabled {
                background: #e8e5df;
                border-color: #e8e5df;
                color: #8b867e;
                cursor: not-allowed;
            }

        .customer-menu .promo-card,
        .customer-menu .combo-card,
        .customer-menu .coupon-card {
            height: 100%;
            padding: 23px;
            background: white;
            border: 1px solid #eee9e1;
            border-radius: 18px;
            transition: .2s ease;
        }

            .customer-menu .promo-card:hover,
            .customer-menu .combo-card:hover,
            .customer-menu .coupon-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 28px #3429180e;
            }

        .customer-menu .special-icon {
            display: grid;
            place-items: center;
            width: 54px;
            height: 54px;
            flex-shrink: 0;
            border-radius: 15px;
            background: #fff4d9;
            color: #a36b12;
            font-size: 1.65rem;
        }

        .customer-menu .special-title {
            font-weight: 800;
            font-size: 1.12rem;
            line-height: 1.4;
        }

        .customer-menu .discount-pill {
            display: inline-flex;
            background: #fce7e5;
            color: #b42318;
            font-size: .8rem;
            font-weight: 800;
            border-radius: 8px;
            padding: 7px 10px;
            white-space: nowrap;
        }

        .customer-menu .btn-special {
            background: #29251f;
            color: white;
            border: 0;
            border-radius: 10px;
            padding: 11px 15px;
            font-weight: 700;
        }

            .customer-menu .btn-special:hover {
                background: #fbbf24;
                color: #29251f;
            }

        .customer-menu .coupon-code {
            border: 1px dashed #d6a74c;
            background: #fff9eb;
            color: #8b5c10;
            font-weight: 900;
            letter-spacing: 1.3px;
            padding: 12px;
            border-radius: 10px;
            font-size: 1.1rem;
        }

        .customer-menu .empty-state {
            padding: 50px 20px;
            text-align: center;
            background: white;
            border: 1px dashed #ddd3c2;
            border-radius: 18px;
        }

            .customer-menu .empty-state i {
                font-size: 3rem;
                color: #d5a447;
            }

    @@media (max-width: 767px) {
        .customer-menu .menu-hero {
            padding: 25px 21px;
        }

        .customer-menu .hero-decoration {
            right: 10px;
            top: 22px;
            transform: none;
            font-size: 70px;
        }

        .customer-menu .menu-benefits {
            grid-template-columns: 1fr;
        }

        .customer-menu .menu-tabs {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

            .customer-menu .menu-tabs .nav-link {
                text-align: center;
                padding: 11px 7px;
                font-size: .85rem;
            }

        .customer-menu .food-art {
            height: 125px;
        }

        .customer-menu .food-content {
            height: calc(100% - 125px);
        }
    }
</style>

<div class="container customer-menu py-4">

    <section class="menu-hero">
        <div class="row align-items-center position-relative">
            <div class="col-lg-8">
                <span class="hero-kicker">
                    <i class="bi bi-stars"></i> Hương vị mỗi ngày
                </span>
                <h1>Hôm nay bạn muốn ăn gì?</h1>
                <p>
                    Khám phá thực đơn, chọn món yêu thích và đặt giao tận nơi.
                    Những món ngon luôn sẵn sàng cho bữa ăn của bạn.
                </p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a asp-action="Menu" asp-route-tab="items"
                       class="btn btn-warning fw-bold px-4 py-3 rounded-3">
                        <i class="bi bi-egg-fried me-2"></i>Khám phá thực đơn
                    </a>
                    <a asp-action="Cart" class="btn btn-outline-light fw-bold px-4 py-3 rounded-3">
                        <i class="bi bi-bag me-2"></i>Xem giỏ hàng
                    </a>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-block">
                <div class="text-end pe-4">
                    <div class="fs-5 fw-bold">Đặt món dễ dàng</div>
                    <div class="text-white-50 mt-2">Chọn món · Xác nhận · Nhận hàng</div>
                </div>
            </div>
        </div>
        <div class="hero-decoration"><i class="bi bi-egg-fried"></i></div>
    </section>

    <div class="menu-benefits">
        <div class="benefit">
            <div class="benefit-icon"><i class="bi bi-basket2"></i></div>
            <div>
                <strong>Đa dạng món ngon</strong>
                <small>Nhiều lựa chọn cho bạn</small>
            </div>
        </div>
        <div class="benefit">
            <div class="benefit-icon"><i class="bi bi-tag"></i></div>
            <div>
                <strong>Ưu đãi hấp dẫn</strong>
                <small>Combo và mã giảm giá</small>
            </div>
        </div>
        <div class="benefit">
            <div class="benefit-icon"><i class="bi bi-house-door"></i></div>
            <div>
                <strong>Đặt giao tận nơi</strong>
                <small>Đặt món ngay trên website</small>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <h2 class="fw-bold mb-1">Thực đơn của chúng tôi</h2>
            <p class="text-secondary mb-0">Chọn món ngon, thêm vào giỏ và đặt hàng thật nhanh.</p>
        </div>
        <a asp-action="Cart" class="btn-menu-cart">
            <i class="bi bi-bag-check fs-5"></i>
            Giỏ hàng
            <span id="cart-badge" class="badge rounded-pill bg-danger">0</span>
        </a>
    </div>

    <nav class="menu-tabs" aria-label="Danh mục thực đơn">
        <a class="nav-link @(currentTab == "items" ? "active" : "")"
           asp-action="Menu" asp-route-tab="items">
            <i class="bi bi-egg-fried me-1"></i> Món ăn
            <span class="small ms-1">(@menuItems.Count)</span>
        </a>
        <a class="nav-link @(currentTab == "combos" ? "active" : "")"
           asp-action="Menu" asp-route-tab="combos">
            <i class="bi bi-box-seam me-1"></i> Combo
        </a>
        <a class="nav-link @(currentTab == "promos" ? "active" : "")"
           asp-action="Menu" asp-route-tab="promos">
            <i class="bi bi-clock-history me-1"></i> Giờ vàng
        </a>
        <a class="nav-link @(currentTab == "coupons" ? "active" : "")"
           asp-action="Menu" asp-route-tab="coupons">
            <i class="bi bi-ticket-perforated me-1"></i> Mã ưu đãi
        </a>
    </nav>

    @if (currentTab == "items")
    {
        <div class="menu-filter">
            <form method="get" asp-action="Menu" class="row g-2 align-items-center">
                <input type="hidden" name="tab" value="items" />

                <div class="col-lg-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search text-secondary"></i>
                        </span>
                        <input type="text" name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control"
                               placeholder="Bạn muốn tìm món gì?" />
                    </div>
                </div>

                <div class="col-lg-4">
                    <select name="categoryId" class="form-select"
                            asp-items="@(new SelectList(categories, "Id", "Name", ViewBag.CurrentCategory))">
                        <option value="">Tất cả danh mục</option>
                    </select>
                </div>

                <div class="col-lg-2">
                    <button type="submit" class="btn-filter">
                        <i class="bi bi-sliders me-1"></i> Lọc món
                    </button>
                </div>
            </form>
        </div>

        <div class="section-heading">
            <div>
                <h2>Món ăn nổi bật</h2>
                <p>@menuItems.Count món trong danh sách hiện tại</p>
            </div>
        </div>

        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 g-lg-4">
            @if (menuItems.Any())
            {
                @foreach (var m in menuItems)
                {
                    var categoryName = categories.FirstOrDefault(c => c.Id == m.CategoryId)?.Name ?? "Món ngon";

                    <div class="col">
                        <article class="food-card">
                            <div class="food-art">
                                @if (m.Stopped)
                                {
                                    <span class="food-badge sold-out">Tạm hết món</span>
                                }
                                else
                                {
                                    <span class="food-badge">
                                        <i class="bi bi-clock me-1"></i>@m.PrepMinutes phút
                                    </span>
                                }

                                <div class="food-emoji">
                                    @(!string.IsNullOrWhiteSpace(m.Icon) ? m.Icon : "🍽️")
                                </div>
                            </div>

                            <div class="food-content">
                                <div class="food-category">@categoryName</div>
                                <h3 class="food-name">@m.Name</h3>

                                @if (!string.IsNullOrWhiteSpace(m.Description))
                                {
                                    <p class="food-description">@m.Description</p>
                                }
                                else
                                {
                                    <p class="food-description">Món ngon được chuẩn bị theo thực đơn của nhà hàng.</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(m.Allergens))
                                {
                                    <div class="small text-warning-emphasis mb-3">
                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                        Dị ứng: @m.Allergens
                                    </div>
                                }

                                <div class="mt-auto">
                                    <div class="food-price mb-3">@m.Price.ToString("N0") đ</div>

                                    <button type="button"
                                            class="btn-add-food add-to-cart"
                                            data-id="item_@m.Id"
                                            data-name="@m.Name"
                                            data-price="@m.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            @(m.Stopped ? "disabled" : "")>
                                        @if (m.Stopped)
                                        {
                                            <i class="bi bi-slash-circle me-1"></i>
                            
                                            <text>Tạm hết hàng</text>
                                        }
                                        else
                                        {
                                            <i class="bi bi-plus-circle me-1"></i>
                            
                                            <text>Thêm vào giỏ</text>
                                        }
                                    </button>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="empty-state">
                        <i class="bi bi-search d-block mb-3"></i>
                        <h4 class="fw-bold">Chưa tìm thấy món phù hợp</h4>
                        <p class="text-secondary mb-3">Hãy thử từ khóa khác hoặc chọn lại danh mục.</p>
                        <a asp-action="Menu" asp-route-tab="items" class="btn btn-dark rounded-3 px-4">
                            Xem tất cả món
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else if (currentTab == "combos")
    {
        <div class="section-heading">
            <div>
                <h2>Combo tiết kiệm</h2>
                <p>Kết hợp nhiều món với mức giá hấp dẫn hơn.</p>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-2 g-3 g-lg-4">
            @if (combos.Any(c => c.Active))
            {
                @foreach (var c in combos.Where(x => x.Active))
                {
                    var retailPrice = c.Items?.Sum(i => i.MenuItem.Price * i.Qty) ?? 0;
                    var discountPercent = retailPrice <= 0 || c.Price >= retailPrice
                    ? 0
                    : (int)Math.Round((retailPrice - c.Price) * 100 / retailPrice);

                    <div class="col">
                        <article class="combo-card d-flex flex-column">
                            <div class="d-flex align-items-start gap-3">
                                <div class="special-icon"><i class="bi bi-box-seam"></i></div>
                                <div class="flex-grow-1">
                                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                        <h3 class="special-title mb-1">@c.Name</h3>
                                        @if (discountPercent > 0)
                                        {
                                            <span class="discount-pill">Tiết kiệm @discountPercent%</span>
                                        }
                                    </div>
                                    <p class="text-secondary small mb-3">Một lựa chọn tiện lợi cho bữa ăn của bạn.</p>
                                </div>
                            </div>

                            <div class="p-3 rounded-3 mb-3" style="background:#faf8f4;">
                                <div class="fw-bold small mb-2">
                                    <i class="bi bi-basket me-1"></i> Bao gồm
                                </div>
                                <div class="text-secondary small">
                                    @if (c.Items != null && c.Items.Any())
                                    {
                                        @string.Join(", ", c.Items.Select(i => i.MenuItem.Name + " × " + i.Qty))
                                    }
                                    else
                                    {
                                        <span>Thông tin các món đang được cập nhật.</span>
                                    }
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center gap-3 mt-auto pt-3 border-top">
                                <div>
                                    @if (retailPrice > c.Price)
                                    {
                                        <div class="text-secondary small text-decoration-line-through">
                                            @retailPrice.ToString("N0") đ
                                        </div>
                                    }
                                    <div class="food-price">@c.Price.ToString("N0") đ</div>
                                </div>

                                <button type="button" class="btn-special add-to-cart"
                                        data-id="combo_@c.Id"
                                        data-name="@c.Name"
                                        data-price="@c.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    <i class="bi bi-plus-lg me-1"></i> Chọn combo
                                </button>
                            </div>
                        </article>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="empty-state">
                        <i class="bi bi-box-seam d-block mb-3"></i>
                        <h4 class="fw-bold">Chưa có combo đang mở bán</h4>
                        <p class="text-secondary mb-0">Bạn có thể quay lại xem các món ăn riêng.</p>
                    </div>
                </div>
            }
        </div>
    }
    else if (currentTab == "promos")
    {
        <div class="section-heading">
            <div>
                <h2>Khung giờ ưu đãi</h2>
                <p>Kiểm tra thời gian áp dụng trước khi đặt món.</p>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-2 g-3">
            @if (promos.Any(p => p.Active))
            {
                @foreach (var p in promos.Where(x => x.Active))
                {
                    <div class="col">
                        <article class="promo-card">
                            <div class="d-flex gap-3 align-items-start">
                                <div class="special-icon"><i class="bi bi-alarm"></i></div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                        <h3 class="special-title mb-0">@p.Name</h3>
                                        <span class="discount-pill">Giảm @p.Percent%</span>
                                    </div>
                                    <div class="fw-bold mb-2">
                                        <i class="bi bi-clock me-1 text-secondary"></i>
                                        @p.StartTime – @p.EndTime
                                    </div>
                                    <p class="text-secondary small mb-0">
                                        Danh mục:
                                        <strong>@(p.Category?.Name ?? "Tất cả món ăn")</strong>
                                    </p>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="empty-state">
                        <i class="bi bi-clock-history d-block mb-3"></i>
                        <h4 class="fw-bold">Hiện chưa có ưu đãi giờ vàng</h4>
                        <p class="text-secondary mb-0">Vui lòng quay lại sau để xem chương trình mới.</p>
                    </div>
                </div>
            }
        </div>
    }
    else if (currentTab == "coupons")
    {
        <div class="section-heading">
            <div>
                <h2>Mã giảm giá</h2>
                <p>Sao chép mã và kiểm tra điều kiện áp dụng cho đơn hàng.</p>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            @if (coupons.Any(c => c.Active))
            {
                @foreach (var c in coupons.Where(x => x.Active))
                {
                    <div class="col">
                        <article class="coupon-card d-flex flex-column">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="special-icon"><i class="bi bi-ticket-perforated"></i></div>
                                <div>
                                    <div class="small text-secondary">Ưu đãi dành cho bạn</div>
                                    <div class="fw-bold">Mã giảm giá</div>
                                </div>
                            </div>

                            <div class="coupon-code text-center mb-3">@c.Code</div>

                            <h3 class="text-danger fw-bold mb-2">
                                @if (c.Percent > 0)
                                {
                                    <text>Giảm @c.Percent%</text>
                                }
                                else
                                {
                                    <text>Giảm @c.Amount.ToString("N0") đ</text>
                                }
                            </h3>

                            <div class="small text-secondary mb-2">
                                Đơn tối thiểu: <strong>@c.MinTotal.ToString("N0") đ</strong>
                            </div>
                            <div class="small text-secondary mb-3">
                                Hạn sử dụng:
                                <strong>@(c.ExpireDate.HasValue? c.ExpireDate.Value.ToString("dd/MM/yyyy") : "Không giới hạn")</strong>
                            </div>

                            <button type="button"
                                    class="btn-special copy-coupon mt-auto"
                                    data-code="@c.Code">
                                <i class="bi bi-clipboard me-1"></i> Sao chép mã
                            </button>
                        </article>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="empty-state">
                        <i class="bi bi-ticket-perforated d-block mb-3"></i>
                        <h4 class="fw-bold">Chưa có mã giảm giá hoạt động</h4>
                        <p class="text-secondary mb-0">Các mã ưu đãi mới sẽ được cập nhật tại đây.</p>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function readCart() {
            try {
                const value = JSON.parse(localStorage.getItem('cart') || '[]');
                return Array.isArray(value) ? value : [];
            } catch {
                return [];
            }
        }

        function saveCart(cart) {
            localStorage.setItem('cart', JSON.stringify(cart));
            updateCartBadge();
        }

        function updateCartBadge() {
            const cart = readCart();
            const totalQty = cart.reduce((sum, item) => {
                return sum + Math.max(0, Number(item.qty) || 0);
            }, 0);

            const badge = document.getElementById('cart-badge');
            if (badge) badge.textContent = totalQty;
        }

        document.querySelectorAll('.add-to-cart').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.dataset.id;
                const name = this.dataset.name;
                const price = Number(this.dataset.price);

                if (!id || !name || !Number.isFinite(price) || price < 0) {
                    alert('Thông tin món ăn không hợp lệ. Vui lòng tải lại trang.');
                    return;
                }

                const cart = readCart();
                const existing = cart.find(item => item.id === id);

                if (existing) {
                    existing.qty = (Number(existing.qty) || 0) + 1;
                } else {
                    cart.push({ id, name, price, qty: 1 });
                }

                saveCart(cart);

                const originalHtml = this.innerHTML;
                const originalClass = this.className;

                this.innerHTML = '<i class="bi bi-check-circle me-1"></i> Đã thêm món';
                this.className = 'btn-add-food';
                this.style.background = '#15803d';
                this.style.borderColor = '#15803d';

                setTimeout(() => {
                    this.innerHTML = originalHtml;
                    this.className = originalClass;
                    this.style.background = '';
                    this.style.borderColor = '';
                }, 1000);
            });
        });

        document.querySelectorAll('.copy-coupon').forEach(button => {
            button.addEventListener('click', async function () {
                const code = this.dataset.code;
                if (!code) return;

                try {
                    await navigator.clipboard.writeText(code);
                } catch {
                    const input = document.createElement('textarea');
                    input.value = code;
                    input.style.position = 'fixed';
                    input.style.opacity = '0';
                    document.body.appendChild(input);
                    input.select();
                    const copied = document.execCommand('copy');
                    input.remove();

                    if (!copied) {
                        alert('Không thể sao chép tự động. Mã ưu đãi: ' + code);
                        return;
                    }
                }

                const originalHtml = this.innerHTML;
                this.innerHTML = '<i class="bi bi-check-circle me-1"></i> Đã sao chép';

                setTimeout(() => {
                    this.innerHTML = originalHtml;
                }, 1500);
            });
        });

        updateCartBadge();
    </script>
}
