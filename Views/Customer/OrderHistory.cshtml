@model IEnumerable<QuanLyNhaHang.Models.Order>

@{
    ViewData["Title"] = "Lịch sử đơn hàng";
    Layout = "_CustomerLayout";

    var orders = Model?.OrderByDescending(o => o.OpenedAt).ToList()
                 ?? new List<QuanLyNhaHang.Models.Order>();
}

<style>
    .order-history {
        --order-ink: #29251f;
        --order-muted: #77736c;
        padding-bottom: 48px;
        color: var(--order-ink);
    }

        .order-history .history-hero {
            padding: 30px;
            border-radius: 22px;
            background: linear-gradient(120deg, #29251f, #514333);
            color: white;
            margin-bottom: 25px;
        }

            .order-history .history-hero h1 {
                font-size: clamp(1.6rem, 3vw, 2.25rem);
                font-weight: 800;
                margin: 10px 0;
            }

            .order-history .history-hero p {
                color: #e8e0d5;
                margin-bottom: 0;
            }

        .order-history .history-icon {
            width: 56px;
            height: 56px;
            display: grid;
            place-items: center;
            background: #ffffff17;
            border: 1px solid #ffffff24;
            border-radius: 16px;
            font-size: 1.65rem;
            flex-shrink: 0;
        }

        .order-history .history-stat {
            height: 100%;
            padding: 18px;
            background: white;
            border: 1px solid #eee9e1;
            border-radius: 16px;
        }

            .order-history .history-stat .stat-icon {
                width: 40px;
                height: 40px;
                display: grid;
                place-items: center;
                border-radius: 12px;
                background: #fff4d9;
                color: #a36b12;
                margin-bottom: 12px;
                font-size: 1.2rem;
            }

            .order-history .history-stat .stat-label {
                color: var(--order-muted);
                font-size: .85rem;
            }

            .order-history .history-stat .stat-value {
                font-size: 1.55rem;
                font-weight: 800;
                margin-top: 3px;
            }

        .order-history .order-card {
            overflow: hidden;
            border: 1px solid #eee9e1;
            border-radius: 18px;
            background: white;
            transition: box-shadow .2s ease, transform .2s ease;
        }

            .order-history .order-card:hover {
                box-shadow: 0 12px 28px #3429180c;
                transform: translateY(-2px);
            }

        .order-history .order-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            padding: 18px 22px;
            background: #faf8f4;
            border-bottom: 1px solid #eee9e1;
        }

        .order-history .order-number {
            font-size: 1.08rem;
            font-weight: 800;
        }

        .order-history .order-date {
            color: var(--order-muted);
            font-size: .84rem;
            margin-top: 4px;
        }

        .order-history .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 12px;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .order-history .status-pending {
            color: #8a5b00;
            background: #fff0c2;
        }

        .order-history .status-cancelled {
            color: #b42318;
            background: #fee4e2;
        }

        .order-history .status-complete {
            color: #166534;
            background: #dcfce7;
        }

        .order-history .order-card-body {
            padding: 21px 22px;
        }

        .order-history .detail-row {
            display: flex;
            gap: 12px;
            margin-bottom: 17px;
        }

        .order-history .detail-icon {
            display: grid;
            place-items: center;
            width: 39px;
            height: 39px;
            flex-shrink: 0;
            border-radius: 11px;
            background: #f5f2ec;
            color: #8c6a2d;
            font-size: 1.1rem;
        }

        .order-history .detail-label {
            color: var(--order-muted);
            font-size: .8rem;
            margin-bottom: 3px;
        }

        .order-history .detail-value {
            font-weight: 650;
            overflow-wrap: anywhere;
        }

        .order-history .order-total {
            background: #fff9eb;
            border: 1px solid #f2e5c7;
            border-radius: 13px;
            padding: 14px 16px;
        }

            .order-history .order-total .amount {
                color: #b42318;
                font-size: 1.45rem;
                font-weight: 900;
            }

        .order-history .btn-cancel-order {
            padding: 10px 14px;
            border-radius: 10px;
            font-weight: 700;
        }

        .order-history .empty-orders {
            padding: 55px 22px;
            text-align: center;
            border: 1px dashed #ddd3c2;
            border-radius: 18px;
            background: white;
        }

            .order-history .empty-orders > i {
                color: #d5a447;
                font-size: 3.5rem;
            }

    @@media (max-width: 575px) {
        .order-history .history-hero {
            padding: 22px;
        }

        .order-history .order-card-header,
        .order-history .order-card-body {
            padding: 16px;
        }

        .order-history .order-total .amount {
            font-size: 1.2rem;
        }
    }
</style>

<div class="container order-history py-4">

    <section class="history-hero">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-4">
            <div class="d-flex align-items-start gap-3">
                <div class="history-icon">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
                <div>
                    <div class="small fw-bold text-warning text-uppercase" style="letter-spacing:1px;">
                        Tài khoản khách hàng
                    </div>
                    <h1>Lịch sử đơn hàng</h1>
                    <p>Theo dõi đơn hàng và kiểm tra trạng thái đặt món của bạn.</p>
                </div>
            </div>

            <a asp-action="Menu"
               class="btn btn-warning fw-bold px-4 py-3 rounded-3">
                <i class="bi bi-plus-circle me-2"></i>Đặt món mới
            </a>
        </div>
    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 mb-4">
        <div class="col">
            <div class="history-stat">
                <div class="stat-icon"><i class="bi bi-bag-check"></i></div>
                <div class="stat-label">Tổng đơn hàng</div>
                <div class="stat-value">@orders.Count</div>
            </div>
        </div>

        <div class="col">
            <div class="history-stat">
                <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
                <div class="stat-label">Đơn đang chờ</div>
                <div class="stat-value">@orders.Count(o => o.OrderStatus == "Pending")</div>
            </div>
        </div>

        <div class="col">
            <div class="history-stat">
                <div class="stat-icon"><i class="bi bi-wallet2"></i></div>
                <div class="stat-label">Tổng giá trị đơn</div>
                <div class="stat-value" style="font-size:1.25rem;">
                    @orders.Where(o => o.OrderStatus != "Cancelled").Sum(o => o.Total).ToString("N0") đ
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h2 class="h4 fw-bold mb-1">Đơn hàng của bạn</h2>
            <p class="text-secondary small mb-0">Đơn hàng mới nhất được hiển thị trước.</p>
        </div>
        <span class="badge rounded-pill text-bg-light border px-3 py-2">
            @orders.Count đơn hàng
        </span>
    </div>

    @if (orders.Any())
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var o in orders)
            {
                var isPending = o.OrderStatus == "Pending";
                var isCancelled = o.OrderStatus == "Cancelled";

                var statusClass = isPending
                ? "status-pending"
                : isCancelled
                ? "status-cancelled"
                : "status-complete";

                var statusIcon = isPending
                ? "bi-hourglass-split"
                : isCancelled
                ? "bi-x-circle"
                : "bi-check-circle";

                var statusLabel = isPending
                ? "Đang chờ xác nhận"
                : isCancelled
                ? "Đã hủy"
                : o.OrderStatus;

                <article class="order-card">
                    <div class="order-card-header">
                        <div>
                            <div class="order-number">
                                <i class="bi bi-receipt me-2 text-secondary"></i>
                                Đơn hàng #@o.Id
                            </div>
                            <div class="order-date">
                                <i class="bi bi-calendar3 me-1"></i>
                                Đặt lúc @o.OpenedAt.ToString("HH:mm - dd/MM/yyyy")
                            </div>
                        </div>

                        <span class="status-pill @statusClass">
                            <i class="bi @statusIcon"></i>
                            @statusLabel
                        </span>
                    </div>

                    <div class="order-card-body">
                        <div class="row g-3">
                            <div class="col-md-7">
                                <div class="detail-row">
                                    <div class="detail-icon">
                                        <i class="bi bi-shop"></i>
                                    </div>
                                    <div>
                                        <div class="detail-label">Chi nhánh xử lý</div>
                                        <div class="detail-value">
                                            @(o.Branch?.Name ?? "Chi nhánh chính")
                                        </div>
                                    </div>
                                </div>

                                <div class="detail-row mb-md-0">
                                    <div class="detail-icon">
                                        <i class="bi bi-geo-alt"></i>
                                    </div>
                                    <div>
                                        <div class="detail-label">Địa chỉ giao hàng</div>
                                        <div class="detail-value">
                                            @(string.IsNullOrWhiteSpace(o.ShippingAddress)
                                                                                ? "Chưa có thông tin địa chỉ"
                                                                                : o.ShippingAddress)
                                </div>
                            </div>
                        </div>
                    </div>

                            <div class="col-md-5">
                                <div class="order-total h-100 d-flex flex-column justify-content-center">
                                    <div class="text-secondary small mb-1">Tổng thanh toán</div>
                                    <div class="amount">@o.Total.ToString("N0") đ</div>
                                    <div class="text-secondary small mt-1">
                                        <i class="bi bi-shield-check me-1"></i>
                                        Thông tin đơn hàng
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-4 pt-3 border-top">
                            <div class="small text-secondary">
                                Mã đơn: <strong>#@o.Id</strong>
                            </div>

                    @if (isPending)
                            {
                                <form asp-action="CancelOrder"
                                      asp-route-id="@o.Id"
                                      method="post"
                                      class="m-0"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng #@o.Id không?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-cancel-order">
                                        <i class="bi bi-x-circle me-1"></i> Hủy đơn hàng
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-secondary small">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Không thể hủy đơn này
                                </span>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="empty-orders">
            <i class="bi bi-bag-x d-block mb-3"></i>
            <h3 class="fw-bold mb-2">Bạn chưa có đơn hàng nào</h3>
            <p class="text-secondary mb-4">
                Hãy chọn những món yêu thích và đặt giao tận nơi ngay hôm nay.
            </p>
            <a asp-action="Menu" class="btn btn-warning fw-bold px-4 py-3 rounded-3">
                <i class="bi bi-egg-fried me-2"></i>Khám phá thực đơn
            </a>
        </div>
    }
</div>
