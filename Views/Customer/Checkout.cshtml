@{ Layout = "_CustomerLayout"; }
@{ ViewData["Title"] = "Thanh toán đơn hàng"; var customer = ViewBag.Customer as QuanLyNhaHang.Models.CustomerAccount; var branches = ViewBag.Branches as List<QuanLyNhaHang.Models.Branch>; }
<div class="container py-4" style="max-width:760px"><h1>Thông tin nhận hàng</h1><div asp-validation-summary="All" class="text-danger"></div><form method="post">@Html.AntiForgeryToken()<label class="form-label">Chi nhánh thực hiện đơn</label><select name="BranchId" class="form-select mb-3" required>@foreach(var b in branches){<option value="@b.Id">@b.Name — @b.Address</option>}</select><label class="form-label">Hình thức nhận</label><select name="FulfillmentType" id="fulfillment" class="form-select mb-3"><option>Giao tận nhà</option><option>Tự đến lấy</option></select><label class="form-label">Địa chỉ giao hàng</label><input name="Address" value="@customer?.DefaultAddress" class="form-control mb-3"/><label class="form-label">Số điện thoại</label><input name="Phone" value="@customer?.Phone" class="form-control mb-3"/><label class="form-label">Ghi chú cho tài xế/nhà hàng</label><textarea name="DriverNote" class="form-control mb-3"></textarea><label class="form-label">Mã giảm giá</label><input name="CouponCode" class="form-control mb-3"/><label class="form-label">Thanh toán</label><select name="PaymentMethod" class="form-select mb-3"><option value="COD">Thanh toán khi nhận hàng</option><option value="ONLINE">Thanh toán online/QR (chưa xác nhận thanh toán)</option></select><button class="btn btn-primary">Gửi đơn hàng</button></form></div>
