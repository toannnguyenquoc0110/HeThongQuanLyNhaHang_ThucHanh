@model ReportVM
@{
    ViewData["Title"] = "Báo cáo";
    var maxD = Model.Daily.Any() ? Model.Daily.Max(x => x.Revenue) : 1; if (maxD == 0) { maxD = 1; }
    var maxH = Model.Hours.Any() ? Model.Hours.Max(x => x.Orders) : 1;
    var profit = Model.Revenue - Model.Cogs - Model.Expenses;
}
<div class="head"><div><h1>Báo cáo</h1><p>@Fmt.Dmy(Model.From) – @Fmt.Dmy(Model.To) · @(Model.AllBranches ? "Cả 4 chi nhánh" : "Chi nhánh đang chọn")</p></div>
    <form method="get" style="display:flex;gap:8px;align-items:end;flex-wrap:wrap" class="noprint">
        <div><label for="f">Từ</label><input class="in" id="f" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" /></div>
        <div><label for="t">Đến</label><input class="in" id="t" type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" /></div>
        <div><label for="a">Phạm vi</label><select class="in" id="a" name="all"><option value="false" selected="@(!Model.AllBranches)">Chi nhánh này</option><option value="true" selected="@Model.AllBranches">Tất cả chi nhánh</option></select></div>
        <button class="btn p">Xem</button>
        <a class="btn" asp-action="Export" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-all="@Model.AllBranches">Xuất Excel (CSV)</a>
        <button type="button" class="btn" onclick="window.print()">In / lưu PDF</button></form></div>

<div class="grid g4">
    <div class="stat hero"><b>@Fmt.Vnd(Model.Revenue)</b><span>Doanh thu (@Model.Orders đơn, @Model.Guests khách)</span></div>
    <div class="stat"><b>@Fmt.Vnd(Model.Cogs)</b><span>Giá vốn hàng bán</span></div>
    <div class="stat"><b>@Fmt.Vnd(Model.Expenses)</b><span>Chi phí vận hành</span></div>
    <div class="stat"><b class="@(profit < 0 ? "late" : "")">@Fmt.Vnd(profit)</b><span>Lợi nhuận sau chi phí (tạm tính)</span></div>
</div>

<div class="card" style="margin-top:14px"><h2>Doanh thu theo ngày</h2>
    <div class="chart" role="img" aria-label="Biểu đồ doanh thu theo ngày">@foreach (var d in Model.Daily) { <div class="c" title="@Fmt.Dmy(d.Day): @Fmt.Vnd(d.Revenue)"><i style="height:@((int)(d.Revenue * 100 / maxD))%"></i><span>@d.Day.ToString("dd/MM")</span></div> }</div></div>

<div class="grid g2" style="margin-top:14px">
    <div class="card scroll"><h2>Top món bán chạy</h2>
        @if (!Model.Items.Any()) { <div class="empty">Chưa có dữ liệu.</div> }
        <table><thead><tr><th>Món</th><th class="right">SL</th><th class="right">Doanh thu</th><th class="right">Lãi gộp</th></tr></thead>
        @foreach (var i in Model.Items) { <tr><td>@i.Name</td><td class="right num">@i.Qty</td><td class="right num">@Fmt.Vnd(i.Revenue)</td><td class="right num">@Fmt.Vnd(i.Profit)</td></tr> }</table></div>
    <div class="card"><h2>Giờ cao điểm (số đơn theo giờ mở bàn)</h2>
        <div class="chart">@foreach (var h in Model.Hours) { <div class="c" title="@h.Hour giờ: @h.Orders đơn"><i style="height:@(h.Orders * 100 / (maxH == 0 ? 1 : maxH))%"></i><span>@(h.Hour)h</span></div> }</div></div>
</div>

<div class="grid g2" style="margin-top:14px">
    <div class="card scroll"><h2>So sánh chi nhánh</h2>
        <table><thead><tr><th>Chi nhánh</th><th class="right">Doanh thu</th><th class="right">Đơn</th><th class="right">Chi phí</th></tr></thead>
        @foreach (var b in Model.Branches) { <tr><td>@b.Branch</td><td class="right num">@Fmt.Vnd(b.Revenue)</td><td class="right num">@b.Orders</td><td class="right num">@Fmt.Vnd(b.Expenses)</td></tr> }</table></div>
    <div class="card"><h2>Hình thức thanh toán</h2>
        @foreach (var m in Model.Methods) { <div class="sum"><span>@m.Method</span><b class="num">@Fmt.Vnd(m.Amount)</b></div><div class="bar" style="margin-bottom:8px"><i style="width:@((int)(Model.Revenue == 0 ? 0 : m.Amount * 100 / Model.Revenue))%"></i></div> }</div>
</div>
