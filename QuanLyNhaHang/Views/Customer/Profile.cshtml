@model QuanLyNhaHang.Models.CustomerAccount
@{ Layout = "_CustomerLayout"; ViewData["Title"] = "Tài khoản của tôi"; }
<div class="container py-4" style="max-width:640px">
    <h1>Thông tin tài khoản</h1>
    @if (TempData["ProfileMessage"] != null) { <div class="alert alert-success">@TempData["ProfileMessage"]</div> }
    <div asp-validation-summary="All" class="text-danger"></div>
    <form method="post">@Html.AntiForgeryToken()
        <label class="form-label">Họ tên</label><input name="FullName" value="@Model.FullName" class="form-control mb-3" maxlength="120" required />
        <label class="form-label">Email đăng nhập</label><input value="@Model.Email" class="form-control mb-3" readonly />
        <label class="form-label">Số điện thoại</label><input name="Phone" value="@Model.Phone" class="form-control mb-3" maxlength="30" />
        <label class="form-label">Địa chỉ mặc định</label><textarea name="DefaultAddress" class="form-control mb-3" maxlength="500">@Model.DefaultAddress</textarea>
        <button class="btn btn-primary">Lưu thay đổi</button>
    </form>
</div>
