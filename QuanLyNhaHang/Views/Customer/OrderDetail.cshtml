@model QuanLyNhaHang.Models.Order
@{ Layout = "_CustomerLayout"; }
@{ ViewData["Title"] = "Chi tiết đơn hàng"; }
<div class="container py-4"><h1>Đơn hàng #@Model.Id</h1><p>Trạng thái: <strong>@Model.Status</strong></p>@if (!string.IsNullOrWhiteSpace(Model.RejectReason)) { <div class="alert alert-danger">Lý do từ chối: @Model.RejectReason</div> }<p>Chi nhánh: @Model.Branch?.Name</p><p>Hình thức: @Model.FulfillmentType</p><p>Thanh toán: @(Model.PaymentMethod == "ONLINE" ? "Online / QR" : "Thanh toán khi nhận hàng") — <strong>@Model.PaymentStatus</strong></p><p>Địa chỉ: @Model.DeliveryAddress</p><p>Điện thoại: @Model.DeliveryPhone</p>@if(TempData["OrderMessage"]!=null){<div class="alert alert-info">@TempData["OrderMessage"]</div>}<table class="table"><thead><tr><th>Món</th><th>SL</th><th>Đơn giá</th><th class="text-end">Thành tiền</th></tr></thead><tbody>@foreach(var l in Model.Lines.Where(x => x.Status != QuanLyNhaHang.Models.St.Cancel)){<tr><td>@l.Name</td><td>@l.Qty</td><td>@l.Price.ToString("N0") đ</td><td class="text-end">@((l.Qty * l.Price).ToString("N0")) đ</td></tr>}</tbody></table><div class="text-end"><p>Tạm tính: @Model.Lines.Where(x => x.Status != QuanLyNhaHang.Models.St.Cancel).Sum(x => x.Qty * x.Price).ToString("N0") đ</p><h4>Tổng dự kiến (gồm phí/dịch vụ và VAT): @(((decimal)ViewBag.EstimatedTotal).ToString("N0")) đ</h4><p class="text-muted small">Tổng dự kiến có thể thay đổi nếu nhà hàng điều chỉnh đơn trước khi xác nhận.</p></div><a href="/khach-hang/lich-su">Lịch sử đơn hàng</a></div>
