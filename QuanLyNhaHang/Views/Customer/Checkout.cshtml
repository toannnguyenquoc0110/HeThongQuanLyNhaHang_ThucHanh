@{ Layout = "_CustomerLayout"; }
@{ ViewData["Title"] = "Thanh toán đơn hàng"; var customer = ViewBag.Customer as QuanLyNhaHang.Models.CustomerAccount; var branches = ViewBag.Branches as List<QuanLyNhaHang.Models.Branch>; int selBranch = (int)ViewBag.SelectedBranch; }
<div class="container py-4" style="max-width:760px"><h1>Thông tin nhận hàng</h1><div asp-validation-summary="All" class="text-danger"></div><form method="post">@Html.AntiForgeryToken()<label class="form-label">Chi nhánh thực hiện đơn</label><select name="BranchId" class="form-select mb-1" required><option value="" disabled selected="@(selBranch == 0)">-- Chọn chi nhánh --</option>@foreach(var b in branches){<option value="@b.Id" selected="@(b.Id == selBranch)">@b.Name — @b.Address</option>}</select><div class="form-text mb-3">Đơn chỉ được gửi đến chi nhánh này; nguyên liệu và doanh thu tính riêng cho chi nhánh đó.</div><label class="form-label">Hình thức nhận</label><select name="FulfillmentType" id="fulfillment" class="form-select mb-3"><option>Giao tận nhà</option><option>Tự đến lấy</option></select><label class="form-label">Địa chỉ giao hàng</label><input name="Address" value="@customer?.DefaultAddress" class="form-control mb-3"/><label class="form-label">Số điện thoại <span class="text-danger">*</span></label><input name="Phone" value="@customer?.Phone" class="form-control mb-1" required pattern="(0|\+84)[0-9 ]{9,12}" placeholder="0901 234 567" autocomplete="tel"/><div class="form-text mb-3">Bắt buộc để nhà hàng xác nhận và liên hệ khi có thay đổi về đơn.</div><label class="form-label">Ghi chú cho tài xế/nhà hàng</label><textarea name="DriverNote" class="form-control mb-3"></textarea><label class="form-label">Mã giảm giá</label><input name="CouponCode" class="form-control mb-3"/><label class="form-label">Thanh toán</label><select name="PaymentMethod" class="form-select mb-3"><option value="COD">Thanh toán khi nhận hàng</option><option value="ONLINE">Thanh toán online/QR (chưa xác nhận thanh toán)</option></select><button class="btn btn-primary">Gửi đơn hàng</button></form></div>
