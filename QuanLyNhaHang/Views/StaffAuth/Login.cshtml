@model QuanLyNhaHang.Controllers.StaffAuthController.LoginInput
@{ ViewData["Title"] = "Đăng nhập nhân viên"; Layout = null; }
<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Đăng nhập nội bộ · Vị Nhà</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><style>body{min-height:100vh;display:grid;place-items:center;background:#f3f5f1;font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#173d32}.card-login{width:min(440px,calc(100% - 32px));padding:32px;border:1px solid #e2e8e1;border-radius:24px;background:#fff;box-shadow:0 18px 55px #173d3212}.brand{width:48px;height:48px;border-radius:15px;background:#17483a;color:#fff;display:grid;place-items:center;font-size:24px;font-weight:800}.form-control{padding:12px;border-radius:12px}.btn-primary{background:#17483a;border-color:#17483a;padding:12px;border-radius:12px}.muted{color:#6c7b73;font-size:.92rem}</style></head><body><main class="card-login"><div class="brand mb-3">V</div><p class="text-uppercase small fw-bold mb-1" style="letter-spacing:.16em">Vị Nhà · Nội bộ</p><h1 class="h3 fw-bold mb-2">Đăng nhập nhân viên</h1><p class="muted mb-4">Đăng nhập bằng tài khoản được cấp. Quyền truy cập được xác định từ tài khoản, không thể tự chọn vai trò.</p><form asp-action="Login" method="post"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div><div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" autocomplete="username" placeholder="ten@vinhanh.vn"/><span asp-validation-for="Email" class="text-danger small"></span></div><div class="mb-3"><label asp-for="Password" class="form-label">Mật khẩu</label><input asp-for="Password" type="password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu"/><span asp-validation-for="Password" class="text-danger small"></span></div><button class="btn btn-primary w-100" type="submit">Đăng nhập hệ thống</button></form><hr><p class="muted mb-1">Tài khoản demo chung mật khẩu <code>Demo@12345</code></p><p class="muted mb-0">Quản lý: <code>admin@demo.vn</code><br>Phục vụ: <code>phucvu@demo.vn</code><br>Bếp: <code>bep@demo.vn</code></p><a class="d-block mt-3" href="/khach-hang">← Khu vực khách hàng</a></main></body></html>
