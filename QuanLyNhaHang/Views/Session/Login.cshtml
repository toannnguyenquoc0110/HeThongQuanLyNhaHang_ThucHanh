@model QuanLyNhaHang.Controllers.SessionController.LoginInput
@{
    ViewData["Title"] = "Đăng nhập nhân viên";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập nhân viên · Vị Nhà</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Bricolage+Grotesque:opsz,wght@12..96,500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root{--navy:#122635;--navy2:#1d3547;--red:#be3f2b;--ink:#172b3a;--muted:#657789;--line:#d6e0e7;--canvas:#edf1f3;--paper:#fff}
        *{box-sizing:border-box}
        html,body{min-height:100%;margin:0}
        body{min-height:100vh;background:linear-gradient(180deg,#e9eef1 0%,#f4f5f4 100%);color:var(--ink);font-family:'Be Vietnam Pro',system-ui,sans-serif;display:flex;flex-direction:column}
        .topbar{height:76px;background:var(--navy);color:#fff;display:flex;align-items:center;padding:0 clamp(20px,5vw,64px);gap:13px;box-shadow:0 4px 18px #10233318}
        .brand-mark{width:34px;height:34px;border-radius:9px;background:var(--red);display:grid;place-items:center;color:#fff;font-family:'Bricolage Grotesque',sans-serif;font-size:21px;font-weight:700;transform:rotate(-3deg)}
        .brand-name{font-family:'Bricolage Grotesque',sans-serif;font-size:22px;font-weight:700;letter-spacing:-.3px}
        .brand-divider{height:25px;width:1px;background:#ffffff38;margin:0 2px 0 5px}
        .brand-sub{font-size:12px;color:#b9c8d2}
        .top-spacer{flex:1}
        .top-note{font-size:12px;color:#c6d3dc}
        .stage{flex:1;display:grid;place-items:center;padding:36px 18px 48px}
        .login-card{width:min(100%,470px);background:var(--paper);border:1px solid #dce4e8;border-radius:18px;padding:clamp(26px,5vw,42px);box-shadow:0 18px 55px #172b3a12}
        .eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--red);font-weight:700;font-size:13px;letter-spacing:.2px;margin-bottom:10px}
        .eyebrow:before{content:'';width:7px;height:7px;border-radius:50%;background:var(--red)}
        h1{font-family:'Bricolage Grotesque','Be Vietnam Pro',sans-serif;font-size:clamp(27px,4vw,33px);line-height:1.2;letter-spacing:-.5px;margin:0 0 10px;color:#172b3a}
        .intro{font-size:14px;line-height:1.75;color:var(--muted);margin:0 0 26px}
        .field{margin:0 0 18px}
        label{display:block;margin:0 0 8px;color:#30485a;font-size:13px;font-weight:700}
        .field input{display:block;width:100%;min-height:49px;padding:12px 14px;border:1px solid #cbd7df;border-radius:9px;background:#fff;color:#172b3a;font:inherit;font-size:14px;outline:none;transition:border-color .15s,box-shadow .15s}
        .field input::placeholder{color:#91a0aa}
        .field input:focus{border-color:#46677e;box-shadow:0 0 0 3px #46677e20}
        .error{display:block;color:#b42318;font-size:12px;margin-top:5px}
        .validation-summary-errors{padding:10px 12px;margin:0 0 14px;border:1px solid #f0c7c2;border-radius:8px;background:#fff5f4;color:#a12c20;font-size:13px}
        .validation-summary-errors ul{padding-left:18px;margin:0}
        .submit-btn{width:100%;min-height:49px;margin-top:4px;border:1px solid var(--red);border-radius:9px;background:var(--red);color:#fff;font:inherit;font-size:14px;font-weight:700;cursor:pointer;transition:background .15s,transform .15s}
        .submit-btn:hover{background:#a93424;transform:translateY(-1px)}
        .demo{margin-top:22px;padding:15px 16px;background:#f3f6f7;border:1px solid #e0e7eb;border-radius:10px;color:#465c6c;font-size:12px;line-height:1.9}
        .demo strong{display:block;margin-bottom:4px;color:#20394a;font-size:13px}
        .demo-row{display:flex;gap:8px;justify-content:space-between;flex-wrap:wrap}
        .demo-role{color:#657789}
        .back{display:inline-flex;align-items:center;gap:7px;margin-top:22px;color:#34556b;text-decoration:none;font-size:13px;font-weight:600}
        .back:hover{color:var(--red);text-decoration:underline}
        .page-foot{text-align:center;padding:0 18px 20px;color:#7c8b95;font-size:11px}
        @@media(max-width:520px){.topbar{height:66px;padding:0 18px}.brand-sub,.top-note{display:none}.login-card{padding:26px 22px;border-radius:14px}.stage{padding-top:24px;align-items:start}}
    </style>
</head>
<body>
    <header class="topbar">
        <span class="brand-mark" aria-hidden="true">V</span>
        <span class="brand-name">Vị Nhà</span>
        <span class="brand-divider"></span>
        <span class="brand-sub">Quản lý nhà hàng</span>
        <span class="top-spacer"></span>
        <span class="top-note">Hệ thống nội bộ · Nhân viên</span>
    </header>

    <main class="stage">
        <section class="login-card" aria-labelledby="login-title">
            <div class="eyebrow">VỊ NHÀ · NHÂN SỰ</div>
            <h1 id="login-title">Đăng nhập nhân viên</h1>
            <p class="intro">Sử dụng tài khoản được cấp để truy cập các chức năng theo đúng vai trò của bạn.</p>
            <form method="post" action="/nhan-vien/dang-nhap">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="error"></div>
                <div class="field">
                    <label asp-for="Email">Email đăng nhập</label>
                    <input asp-for="Email" type="email" autocomplete="username" placeholder="admin@demo.vn" required />
                    <span asp-validation-for="Email" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Password">Mật khẩu</label>
                    <input asp-for="Password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required />
                    <span asp-validation-for="Password" class="error"></span>
                </div>
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <button class="submit-btn" type="submit">Đăng nhập hệ thống</button>
            </form>

            <div class="demo">
                <strong>Tài khoản demo</strong>
                <div class="demo-row"><span class="demo-role">Quản lý</span><span>admin@demo.vn</span></div>
                <div class="demo-row"><span class="demo-role">Phục vụ</span><span>phucvu@demo.vn</span></div>
                <div class="demo-row"><span class="demo-role">Bếp</span><span>bep@demo.vn</span></div>
                <div class="demo-row"><span class="demo-role">Mật khẩu chung</span><span>Demo@12345</span></div>
            </div>
            <a class="back" href="/khach-hang">← Quay lại trang khách hàng</a>
        </section>
    </main>
    <footer class="page-foot">© @DateTime.Now.Year Vị Nhà · Hệ thống quản lý nhà hàng</footer>
</body>
</html>
